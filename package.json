{
  "name": "action-do-spaces-sync",
  "version": "1.0.0",
  "description": "GitHub Action that syncs a repo or directory to a DigitalOcean Space",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js",
    "test": "node --test src/__tests__/index.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "github-action",
    "digitalocean",
    "spaces",
    "sync"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.4"
  }
}
